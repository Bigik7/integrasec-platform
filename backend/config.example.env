# Adresse d'écoute
INTEGRASEC_ADDR=:8080

# Fichier SQLite de développement
INTEGRASEC_DB_PATH=./data/integrasec.db

# Clé d'enrôlement des agents (ne pas commiter la vraie valeur)
INTEGRASEC_BOOTSTRAP_KEY=change-me-bootstrap-key

# Limite de taille des payloads JSON (en octets)
INTEGRASEC_MAX_BODY_BYTES=1048576

# Dossier frontend séparé
INTEGRASEC_FRONTEND_DIR=../frontend
